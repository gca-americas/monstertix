# Copy to .env and fill in.  cp .env.example .env

# --- model access: Vertex AI ----------------------------------------------
# Auth comes from Application Default Credentials, not from a key in this file.
# In Cloud Shell you are already authenticated. On a laptop, run once:
#     gcloud auth application-default login
# Written by ./setup.sh, which asks you and confirms it. Left blank on purpose:
# a plausible-looking placeholder here gets adopted silently and everything
# deploys into somebody else's project.
GOOGLE_CLOUD_PROJECT=
# Where the MODEL is served. "global" is right for Gemini on Vertex.
GOOGLE_CLOUD_LOCATION=global
# Where SERVICES live: Cloud Run, Cloud SQL, buckets, Pub/Sub, Scheduler.
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# On Vertex the "-latest" aliases do not exist and return 404. Use a pinned id.
# Known good: gemini-2.5-flash, gemini-2.5-flash-lite
ADK_MODEL=gemini-2.5-flash

# --- local services -------------------------------------------------------
# Written by ./deploy-venue.sh, which setup.sh runs for you. Left blank on
# purpose: an agent pointed at a localhost venue you never started fails in a
# way that looks like the agent is broken.
VENUE_URL=
AGENT_URL=http://127.0.0.1:8000
VENUE_PORT=8080

MEMORY_DIR=./memory
MEMORY_USER=userx

# --- Step 7: make the platform's retry visible in the room ----------------
# Defaults are 1s/2s/4s backoff, which is too slow to demo.
ADK_TRIGGER_RETRY_BASE_DELAY=0.2
ADK_TRIGGER_MAX_RETRIES=3

# --- Step 10 only: written by ./setup-cloud-state.sh and ./deploy-agent.sh -
# PRESALE_TARGET_URL=https://<your-agent>.run.app/trigger/wake
# SESSION_SERVICE_URI=postgresql+asyncpg://adk:<password>@/adk?host=/cloudsql/<connection>
# ARTIFACT_SERVICE_URI=gs://<your-bucket>/artifacts
