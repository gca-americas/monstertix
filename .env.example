# Copy to .env and fill in.  cp .env.example .env

# --- model access: Vertex AI ----------------------------------------------
# Auth comes from Application Default Credentials, not from a key in this file.
# In Cloud Shell you are already authenticated. On a laptop, run once:
#     gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=vibeflix-test-3
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# On Vertex the "-latest" aliases do not exist and return 404. Use a pinned id.
# Verified available in this project: gemini-2.5-flash, gemini-2.5-flash-lite
ADK_MODEL=gemini-2.5-flash

# --- local services -------------------------------------------------------
VENUE_URL=http://127.0.0.1:8080
AGENT_URL=http://127.0.0.1:8000
VENUE_PORT=8080

MEMORY_DIR=./memory
MEMORY_USER=userx

# --- Module 4: make the platform's retry visible in the room --------------
# Defaults are 1s/2s/4s backoff, which is too slow to demo.
ADK_TRIGGER_RETRY_BASE_DELAY=0.2
ADK_TRIGGER_MAX_RETRIES=3

# --- Module 6 only, instructor plane --------------------------------------
# PRESALE_TARGET_URL=https://your-agent.run.app/apps/concert/trigger/pubsub
# SESSION_SERVICE_URI=postgresql://...
# ARTIFACT_SERVICE_URI=gs://your-bucket
